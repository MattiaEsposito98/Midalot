{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "midalot-frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "midalot-backend-dev",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "serve", "--port=8000"],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "midalot-backend-alt",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "serve", "--port=8011"],
      "cwd": "backend",
      "port": 8011,
      "autoPort": false,
      "env": { "APP_URL": "http://localhost:8011", "FRONTEND_URL": "http://localhost:5174" }
    },
    {
      "name": "midalot-frontend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--port", "5174"],
      "port": 5174,
      "autoPort": false,
      "env": { "VITE_API_URL": "http://localhost:8011" }
    }
  ]
}
